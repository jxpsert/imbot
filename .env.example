IM_WFS_HOST=https://tileserver2.incidentcentrale.nl/geoserver/ows # WFS endpoint for IM meldingen, without query parameters.
IM_WFS_POLL_RATE=60 # Polling rate in seconds. How often the bot should check for new meldingen.
IM_FILTER_CITY= # Comma-separated list of cities to filter meldingen by. Leave empty to receive all meldingen.
IM_FILTER_RAYON= # Comma-separated list of rayons to filter meldingen by. Leave empty to receive all meldingen.

PHOTON_HOST=https://photon.komoot.io # Photon geocoding service endpoint. Used to get street names from coordinates.

NOTIFY_CHANNELS=discord,pushover # Notification channels to send meldingen to. Currently 'discord' and 'pushover' are supported.

# Discord keys
DISCORD_WEBHOOK_URL= # Discord webhook URL to send meldingen to

# Pushover keys
PUSHOVER_TOKEN= # Pushover API token to send meldingen to
PUSHOVER_USER_KEY= # Pushover user key to send meldingen to